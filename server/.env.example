# SQLite by default -- zero setup. Swap for a Postgres URL when deploying for real.
DATABASE_URL="file:./dev.db"

PORT=3000

# Base URL this server is reachable at, used to build local "deployed" site links.
PUBLIC_BASE_URL="http://localhost:3000"

# Required in the header `x-admin-key` for every internal endpoint (leads
# list, campaigns, clients, jobs, the admin dashboard). If left blank, a
# random one is generated at boot and printed to the log -- set it here for
# a stable value across restarts, and definitely before deploying anywhere.
ADMIN_API_KEY=

# Where new website-inquiry notifications are sent.
STUDIO_NOTIFY_EMAIL=hallo@grandezza.design

# --- Provider keys -----------------------------------------------------
# Every integration below runs in MOCK mode until its key is set here.
# Dropping in a key flips that provider to the real implementation with
# no code changes -- see server/README.md.

# LLM (Outreach / Site Generation / Marketing agents) -- real Claude calls
ANTHROPIC_API_KEY=

# Email delivery (outbound send)
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL=

# Direct mail (physical letters)
LOB_API_KEY=
